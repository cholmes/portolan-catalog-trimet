{
  "version": 8,
  "name": "TriMet Rail Lines with line codes",
  "metadata": {
    "description": "TriMet's rail cartography with the LINE code drawn along each segment. Because a code such as BGR means three lines share that track, the labels are the fastest way to read which services run where."
  },
