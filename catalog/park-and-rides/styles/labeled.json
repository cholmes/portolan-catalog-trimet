{
  "version": 8,
  "name": "TriMet Park and Rides with names and capacity",
  "metadata": {
    "description": "Capacity-scaled marks labeled with the facility name and its space count, so a reader can identify a specific lot without clicking it."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../park-and-rides.pmtiles"
    }
  },
  "layers": [
    {
      "id": "park-and-rides",
      "type": "circle",
      "source": "data",
      "source-layer": "park-and-rides",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          [
            "*",
            [
              "sqrt",
              [
                "max",
                [
                  "get",
                  "spaces"
                ],
                1
              ]
            ],
            0.11
          ],
          12,
          [
            "*",
            [
              "sqrt",
              [
                "max",
                [
                  "get",
                  "spaces"
                ],
                1
              ]
            ],
            0.22
          ],
          16,
          [
            "*",
            [
              "sqrt",
              [
                "max",
                [
                  "get",
                  "spaces"
                ],
                1
              ]
            ],
            0.4
          ]
        ],
        "circle-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "spaces"
          ],
          0,
          "#D5EEF8",
          150,
          "#7FB6D9",
          350,
          "#4679AA",
          550,
          "#D4451F",
          750,
          "#8C2A10"
        ],
        "circle-opacity": 0.8,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "park-and-rides-labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "park-and-rides",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "concat",
          [
            "get",
            "name"
          ],
          "\n",
          [
            "to-string",
            [
              "get",
              "spaces"
            ]
          ],
          " spaces"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [
          0,
          1
        ],
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.4
      }
    }
  ]
}
