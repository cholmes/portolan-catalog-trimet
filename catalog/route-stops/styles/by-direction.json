{
  "version": 8,
  "name": "TriMet Route Stops by direction",
  "metadata": {
    "description": "Splits stops on DIR. Along a two-way corridor the inbound and outbound stops sit on opposite sides of the street, so this style shows the paired-stop structure of the network directly."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../route-stops.pmtiles"
    }
  },
  "layers": [
    {
      "id": "route-stops-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "route-stops",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "dir"
          ],
          0,
          "#1359AE",
          1,
          "#D05F27",
          "#999999"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "route-stops",
      "type": "circle",
      "source": "data",
      "source-layer": "route-stops",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.4,
          15,
          4
        ],
        "circle-color": [
          "match",
          [
            "get",
            "dir"
          ],
          0,
          "#1359AE",
          1,
          "#D05F27",
          "#999999"
        ],
        "circle-opacity": 0.8,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.6
      }
    }
  ]
}
