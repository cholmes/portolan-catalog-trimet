{
  "version": 8,
  "name": "TriMet Route Stops by stop sequence",
  "metadata": {
    "description": "Ramps color across STOP_SEQ, the position of a stop along its route-direction. Following the ramp traces the direction of travel, and the gradient makes route ends easy to pick out. Sequence numbers restart at every route-direction, so the ramp is only meaningful when the view is filtered to one route."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../route-stops.pmtiles"
    }
  },
  "layers": [
    {
      "id": "route-stops-legend",
      "type": "fill",
      "source": "data",
      "source-layer": "route-stops",
      "paint": {
        "fill-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "stop_seq"
          ],
          1,
          "#FFC52F",
          20,
          "#D05F27",
          45,
          "#C41F3E",
          80,
          "#5B2A86"
        ],
        "fill-opacity": 0
      }
    },
    {
      "id": "route-stops",
      "type": "circle",
      "source": "data",
      "source-layer": "route-stops",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.4,
          15,
          4
        ],
        "circle-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "stop_seq"
          ],
          1,
          "#FFC52F",
          20,
          "#D05F27",
          45,
          "#C41F3E",
          80,
          "#5B2A86"
        ],
        "circle-opacity": 0.85
      }
    }
  ]
}
