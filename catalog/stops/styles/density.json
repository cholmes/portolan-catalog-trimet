{
  "version": 8,
  "name": "TriMet Stops \u2014 density",
  "metadata": {
    "description": "A heatmap of stop density that fades into individual marks past zoom 13. Useful for seeing where the network is dense without drawing thousands of overlapping circles at metro-wide zooms."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../stops.pmtiles"
    }
  },
  "layers": [
    {
      "id": "stops-heat",
      "type": "heatmap",
      "source": "data",
      "source-layer": "stops",
      "maxzoom": 14,
      "paint": {
        "heatmap-weight": 1,
        "heatmap-intensity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.6,
          14,
          2
        ],
        "heatmap-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          10,
          14,
          26
        ],
        "heatmap-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.9,
          14,
          0
        ],
        "heatmap-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "heatmap-density"
          ],
          0,
          "rgba(255,255,255,0)",
          0.2,
          "#D5EEF8",
          0.4,
          "#7FB6D9",
          0.6,
          "#4679AA",
          0.8,
          "#D4451F",
          1,
          "#8C2A10"
        ]
      }
    },
    {
      "id": "stops",
      "type": "circle",
      "source": "data",
      "source-layer": "stops",
      "minzoom": 13,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          2,
          16,
          5
        ],
        "circle-color": "#FFFFFF",
        "circle-stroke-color": "#1A1A1A",
        "circle-stroke-width": 1.4,
        "circle-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14,
          1
        ],
        "circle-stroke-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14,
          1
        ]
      }
    }
  ]
}
