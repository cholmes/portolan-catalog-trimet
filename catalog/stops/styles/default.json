{
  "version": 8,
  "name": "TriMet Stops",
  "metadata": {
    "description": "TriMet's own stop symbol, taken from the GeoServer style `ott:stops`: a white circle with a dark stroke. Radius grows with zoom so all 6,316 stops stay separable in dense corridors."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../stops.pmtiles"
    }
  },
  "layers": [
    {
      "id": "stops",
      "type": "circle",
      "source": "data",
      "source-layer": "stops",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.6,
          13,
          3.4,
          16,
          6
        ],
        "circle-color": "#FFFFFF",
        "circle-stroke-color": "#1A1A1A",
        "circle-stroke-width": 1.6
      }
    }
  ]
}
