{
  "version": 8,
  "name": "TriMet Transit Centers by county",
  "metadata": {
    "description": "Colors the hubs by COUNTY. TriMet's district spans Multnomah, Washington and Clackamas counties, and this style shows how the transfer hubs are distributed across the three."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../transit-centers.pmtiles"
    }
  },
  "layers": [
    {
      "id": "transit-centers",
      "type": "circle",
      "source": "data",
      "source-layer": "transit-centers",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          4,
          12,
          7,
          16,
          12
        ],
        "circle-color": [
          "match",
          [
            "get",
            "county"
          ],
          "Multnomah",
          "#1359AE",
          "Washington",
          "#008342",
          "Clackamas",
          "#D05F27",
          "#999999"
        ],
        "circle-stroke-color": "#1A1A1A",
        "circle-stroke-width": 2
      }
    }
  ]
}
