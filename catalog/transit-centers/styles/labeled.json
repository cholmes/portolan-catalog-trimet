{
  "version": 8,
  "name": "TriMet Transit Centers with names",
  "metadata": {
    "description": "Transit center marks with NAME shown from zoom 9. Fifteen labels never collide, so this style works as a standalone overview of the network's hub structure."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../transit-centers.pmtiles"
    }
  },
  "layers": [
    {
      "id": "transit-centers",
      "type": "circle",
      "source": "data",
      "source-layer": "transit-centers",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          4,
          12,
          7,
          16,
          12
        ],
        "circle-color": "#D4451F",
        "circle-stroke-color": "#1A1A1A",
        "circle-stroke-width": 2
      }
    },
    {
      "id": "transit-centers-labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "transit-centers",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-anchor": "top",
        "text-max-width": 9,
        "text-padding": 4,
        "text-offset": [
          0,
          1.1
        ]
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.4
      }
    }
  ]
}
