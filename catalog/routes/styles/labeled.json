{
  "version": 8,
  "name": "TriMet Routes with route numbers",
  "metadata": {
    "description": "The service-type styling with PUBLIC_RTE drawn along each alignment. Use PUBLIC_RTE rather than RTE for display: it is the number riders see, and it is where lettered services such as FX2 appear."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../routes.pmtiles"
    }
  },
  "layers": [
    {
      "id": "routes",
      "type": "line",
      "source": "data",
      "source-layer": "routes",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "type"
          ],
          "BUS",
          "#4679AA",
          "MAX",
          "#1359AE",
          "SC",
          "#72A130",
          "CR",
          "#6E6E6E",
          "AT",
          "#898E91",
          "#999999"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          [
            "*",
            [
              "match",
              [
                "get",
                "type"
              ],
              "BUS",
              1.0,
              "MAX",
              3.5,
              "SC",
              1.5,
              "CR",
              3.0,
              "AT",
              1.5,
              1.0
            ],
            0.6
          ],
          12,
          [
            "*",
            [
              "match",
              [
                "get",
                "type"
              ],
              "BUS",
              1.0,
              "MAX",
              3.5,
              "SC",
              1.5,
              "CR",
              3.0,
              "AT",
              1.5,
              1.0
            ],
            1.0
          ],
          16,
          [
            "*",
            [
              "match",
              [
                "get",
                "type"
              ],
              "BUS",
              1.0,
              "MAX",
              3.5,
              "SC",
              1.5,
              "CR",
              3.0,
              "AT",
              1.5,
              1.0
            ],
            1.8
          ]
        ],
        "line-opacity": 0.9
      }
    },
    {
      "id": "routes-labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "routes",
      "minzoom": 11,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "public_rte"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "symbol-spacing": 220,
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.6
      }
    }
  ]
}
