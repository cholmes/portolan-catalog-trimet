{
  "version": 8,
  "name": "TriMet Routes by service type",
  "metadata": {
    "description": "Every fixed-route alignment colored by TYPE, following TriMet's own `trimet-routes` MapLibre style: bus lines thin and blue, MAX heaviest, streetcar thin, commuter rail gray. Colors are TriMet's GTFS route_color values, which is what that style resolves at draw time."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../routes.pmtiles"
    }
  },
  "layers": [
    {
      "id": "routes",
      "type": "line",
      "source": "data",
      "source-layer": "routes",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "type"
          ],
          "BUS",
          "#4679AA",
          "MAX",
          "#1359AE",
          "SC",
          "#72A130",
          "CR",
          "#6E6E6E",
          "AT",
          "#898E91",
          "#999999"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          [
            "*",
            [
              "match",
              [
                "get",
                "type"
              ],
              "BUS",
              1.0,
              "MAX",
              3.5,
              "SC",
              1.5,
              "CR",
              3.0,
              "AT",
              1.5,
              1.0
            ],
            0.6
          ],
          12,
          [
            "*",
            [
              "match",
              [
                "get",
                "type"
              ],
              "BUS",
              1.0,
              "MAX",
              3.5,
              "SC",
              1.5,
              "CR",
              3.0,
              "AT",
              1.5,
              1.0
            ],
            1.0
          ],
          16,
          [
            "*",
            [
              "match",
              [
                "get",
                "type"
              ],
              "BUS",
              1.0,
              "MAX",
              3.5,
              "SC",
              1.5,
              "CR",
              3.0,
              "AT",
              1.5,
              1.0
            ],
            1.8
          ]
        ],
        "line-opacity": 0.9
      }
    }
  ]
}
