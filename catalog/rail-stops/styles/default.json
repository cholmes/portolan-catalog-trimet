{
  "version": 8,
  "name": "TriMet Rail Stops by line",
  "metadata": {
    "description": "Station marks filled with the color of the line that serves them, using the same palette as TriMet's `ott:rail` style so this layer sits correctly on top of the rail-lines default style. Stations on shared track take the trunk line's color; the LINE code itself records the full set of services."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../rail-stops.pmtiles"
    }
  },
  "layers": [
    {
      "id": "rail-stops",
      "type": "circle",
      "source": "data",
      "source-layer": "rail-stops",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2.5,
          12,
          4.5,
          16,
          8
        ],
        "circle-color": [
          "match",
          [
            "get",
            "line"
          ],
          "BGRY",
          "#084C8D",
          "BGR",
          "#084C8D",
          "BRY",
          "#084C8D",
          "BR",
          "#084C8D",
          "BG",
          "#084C8D",
          "B",
          "#084C8D",
          "GY",
          "#008852",
          "G",
          "#008852",
          "GO",
          "#F58220",
          "O",
          "#F58220",
          "O/AL/BL",
          "#F58220",
          "R",
          "#D81526",
          "Y",
          "#F8C213",
          "NS",
          "#84BD00",
          "NS/AL",
          "#84BD00",
          "NS/BL",
          "#84BD00",
          "NS/AL/BL",
          "#84BD00",
          "AL",
          "#CE0F69",
          "AL/BL",
          "#CE0F69",
          "BL",
          "#0093B2",
          "WES",
          "#000000",
          "#666666"
        ],
        "circle-stroke-color": "#1A1A1A",
        "circle-stroke-width": 1.8
      }
    }
  ]
}
