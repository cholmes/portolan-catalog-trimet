{
  "version": 8,
  "name": "TriMet Rail Stops with station names",
  "metadata": {
    "description": "Line-colored station marks with STATION names. Unlike the bus stop names, these are real station names, which makes this the most useful style for orienting a reader on the rail network."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../rail-stops.pmtiles"
    }
  },
  "layers": [
    {
      "id": "rail-stops",
      "type": "circle",
      "source": "data",
      "source-layer": "rail-stops",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2.5,
          12,
          4.5,
          16,
          8
        ],
        "circle-color": [
          "match",
          [
            "get",
            "line"
          ],
          "BGRY",
          "#084C8D",
          "BGR",
          "#084C8D",
          "BRY",
          "#084C8D",
          "BR",
          "#084C8D",
          "BG",
          "#084C8D",
          "B",
          "#084C8D",
          "GY",
          "#008852",
          "G",
          "#008852",
          "GO",
          "#F58220",
          "O",
          "#F58220",
          "O/AL/BL",
          "#F58220",
          "R",
          "#D81526",
          "Y",
          "#F8C213",
          "NS",
          "#84BD00",
          "NS/AL",
          "#84BD00",
          "NS/BL",
          "#84BD00",
          "NS/AL/BL",
          "#84BD00",
          "AL",
          "#CE0F69",
          "AL/BL",
          "#CE0F69",
          "BL",
          "#0093B2",
          "WES",
          "#000000",
          "#666666"
        ],
        "circle-stroke-color": "#1A1A1A",
        "circle-stroke-width": 1.8
      }
    },
    {
      "id": "rail-stops-labels",
      "type": "symbol",
      "source": "data",
      "source-layer": "rail-stops",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "get",
          "station"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-anchor": "top",
        "text-max-width": 9,
        "text-padding": 4,
        "text-offset": [
          0,
          0.9
        ]
      },
      "paint": {
        "text-color": "#1A1A1A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.4
      }
    }
  ]
}
