# Data files are never committed. They are regenerated by tools/convert.py from
# the Shapefiles in sources/, and published to S3 by tools/publish.py. The
# catalog metadata in catalog/ IS committed; only the bytes it describes are not.
*.parquet
*.pmtiles
*.geojsonl

# Source downloads. tools/fetch.py re-fetches them from developer.trimet.org.
sources/shp/
sources/zip/
sources/kml/
sources/*.zip
gtfs/

# Local render scratch
catalog/*/.render-style.json
catalog/*/.thumbnail.*.tmp

.env
__pycache__/
*.pyc
.DS_Store
